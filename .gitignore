# Python
# uv.lock records the package index URL used locally (possibly a private mirror); CI resolves from PyPI.
uv.lock
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Node
node_modules/
apps/**/dist/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.pfx
*.key

# Azure Developer CLI environment state (contains resource names and settings)
.azure/

# Generated data: regenerate with scripts; only small curated samples are committed
data/generated/
data/local/*
!data/local/README.md

# Real-brand mappings must never be committed
**/real_brand_mapping*.*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
